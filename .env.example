# Application Configuration
FLASK_APP=run.py
FLASK_ENV=production
SECRET_KEY=replace-with-a-secure-random-secret-key-32bytes-hex
DATABASE_PATH=instance/uptime_monitor.sqlite3

# Monitoring Defaults
DEFAULT_MONITOR_INTERVAL_SECONDS=60
DEFAULT_REQUEST_TIMEOUT_SECONDS=10
ALLOW_LOCALHOST_MONITORING=false

# Optional SMTP Email Alert Settings
SMTP_ENABLED=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_RECIPIENT=
ALERT_EMAIL_SENDER=no-reply@uptime-monitor.local
